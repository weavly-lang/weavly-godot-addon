; Minimal project used by CI to export a game that uses the addon.
; addons/weavly is copied in by the workflow, it is not duplicated in the repo.

config_version=5

[application]

config/name="Weavly Export Smoke"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[rendering]

renderer/rendering_method="gl_compatibility"
