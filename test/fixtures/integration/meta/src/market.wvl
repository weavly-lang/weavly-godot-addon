@node stall
@meta
pool: market
tag: "fresh"
priority: shop.cost
weight: 2
@endmeta
Stall.
@endnode

@node moody
@meta
urgent: $mood
cost: $bonus
@endmeta
Moody.
@endnode

@node chain
@meta
cost: moody.cost + 1
@endmeta
Chain.
@endnode

@node moody_check
@if moody.urgent
Urgent.
@endif
After.
@endnode
