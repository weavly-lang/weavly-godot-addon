@env
meta cost: number = 1
meta tag: string = "plain"
meta urgent: bool = false
var gold: number = 5
var paid: number = 0
var rolled: number = 0
extern var mood: bool
extern var bonus: number
pool market
slot table
@endenv

@node Shop
@meta
pool: market
slot: table
cost: 2 + gold
available: gold >= .cost
@endmeta
@set paid = .cost
@if Stall.tag == "fresh"
Fresh.
@endif
@endnode

@node Plain
Plain.
@endnode

@node Lucky
@meta
cost: random(1, 1000)
@endmeta
@set rolled = .cost
@endnode

@node OnceOnly
@meta
once: true
@endmeta
Once.
@endnode
