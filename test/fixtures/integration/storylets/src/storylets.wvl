@env
var gold: number = 0
var count: number = 0
extern var mood: bool
pool when_test
pool priority_test
pool weight_test
pool slot_test
pool left
pool right
pool skip_test
pool error_test
pool shuffle_test
pool unused
slot a
slot b
slot c
slot d
slot x
slot k
@endenv

@node WhenYes
@meta
pool: when_test
when: gold >= 0
@endmeta
@endnode

@node WhenNo
@meta
pool: when_test
when: gold > 100
@endmeta
@endnode

@node Low
@meta
pool: priority_test
priority: 1
@endmeta
@endnode

@node High
@meta
pool: priority_test
priority: 5
@endmeta
@endnode

@node Mid
@meta
pool: priority_test
priority: 3
@endmeta
@endnode

@node Heavy
@meta
pool: weight_test
weight: 1000
@endmeta
@endnode

@node Light
@meta
pool: weight_test
weight: 1
@endmeta
@endnode

@node Weightless
@meta
pool: weight_test
weight: 0
@endmeta
@endnode

@node InAbc
@meta
pool: slot_test
slot: a, b, c
priority: 3
@endmeta
@endnode

@node InA
@meta
pool: slot_test
slot: a
priority: 2
@endmeta
@endnode

@node InC
@meta
pool: slot_test
slot: c
priority: 2
@endmeta
@endnode

@node InD
@meta
pool: slot_test
slot: d
priority: 1
@endmeta
@endnode

@node Free
@meta
pool: slot_test
@endmeta
@endnode

@node BothSides
@meta
pool: left, right
priority: 3
@endmeta
@endnode

@node LeftX
@meta
pool: left
slot: x
priority: 2
@endmeta
@endnode

@node RightX
@meta
pool: right
slot: x
priority: 1
@endmeta
@endnode

@node First
@meta
pool: skip_test
slot: k
priority: 2.5
@endmeta
@endnode

@node Patient
@meta
pool: skip_test
slot: k
priority: skip_count()
@endmeta
@endnode

@node Never
@meta
pool: skip_test
when: gold > 100
@endmeta
@endnode

@node Moody
@meta
pool: error_test
when: mood
@endmeta
@endnode

@node Calm
@meta
pool: error_test
@endmeta
@endnode

@node CountSkips
@set count = skip_count(Patient)
@endnode

@node S1
@meta
pool: shuffle_test
@endmeta
@endnode

@node S2
@meta
pool: shuffle_test
@endmeta
@endnode

@node S3
@meta
pool: shuffle_test
@endmeta
@endnode

@node S4
@meta
pool: shuffle_test
@endmeta
@endnode

@node DrawOne
@draw when_test
@set count = 1
@endnode

@node DrawSeveral
@draw left, right
@endnode

@node DrawNone
@draw unused
@set count = 5
@endnode

@node DrawSkips
@draw skip_test, skip_test
@endnode

@node Talk
Hello.
@endnode

@node MenuZeta
@meta
pool: menu
slot: m
weight: 1000
@endmeta
@endnode

@node MenuAlpha
@meta
pool: menu
weight: 0
@endmeta
@endnode

@node MenuBeta
@meta
pool: menu
slot: m
@endmeta
@endnode

@node MenuTop
@meta
pool: menu
priority: 1
@endmeta
@endnode
