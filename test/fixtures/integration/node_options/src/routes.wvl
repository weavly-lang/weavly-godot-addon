@env
pool locked_test
pool fire_test
slot fire
@endenv

@node Journey
@options
@option node(GoOn)
@option node(Deep)
@option node(Gamble)
@endoptions
Back on the journey.
@endnode

@node GoOn
@meta
label: "Go on"
@endmeta
You go.
@jump Road
@endnode

@node Road
Road.
@endnode

@node Deep
@meta
label: "Go deep"
@endmeta
@options
@option "Inner"
    Inner.
@endoptions
Deep end.
@endnode

@node Stuck
@options
@option node(Hack)
@endoptions
After stuck.
@endnode

@node LockedMenu
@options
@option pool(locked_test, limit: 2, shuffle: false, locked: extra)
@endoptions
@endnode

@node LtOpen
@meta
pool: locked_test
label: "Open"
@endmeta
@endnode

@node LtTease
@meta
pool: locked_test
label: "x"
label_teaser: "Tease"
when: false
@endmeta
@endnode

@node LtPoor
@meta
pool: locked_test
label: "y"
label_unavailable: "Poor"
available: false
@endmeta
@endnode

@node LtHidden
@meta
pool: locked_test
label: "z"
when: false
@endmeta
@endnode

@node LtGone
@meta
pool: locked_test
label: "w"
available: false
@endmeta
@endnode

@node LtLast
@meta
pool: locked_test
label: "Last"
@endmeta
@endnode

@node FireTease
@meta
pool: fire_test
slot: fire
label: "a"
label_teaser: "Fire tease"
when: false
priority: 2
@endmeta
@endnode

@node FireCook
@meta
pool: fire_test
slot: fire
label: "Fire cook"
priority: 1
@endmeta
@endnode

@node FireDance
@meta
pool: fire_test
slot: fire
label: "Fire dance"
@endmeta
@endnode
