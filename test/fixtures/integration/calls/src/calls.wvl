@env
func trust(from: string, to: node): number
func mood(): bool
func greeting(name: string): string
func next_scene(): node
func region(): pool
func partner(): slot
func shout(text: string, volume: number)
func wave()
meta cost: number = 1
var score: number = 0
var scene: node = Start
var area: pool = city
var seat: slot = bob
pool city
slot bob
@endenv

@node Start
@meta
pool: city
slot: bob
cost: trust("ann", Start) + 1
@endmeta
@set score = trust("ann", Start)
@if mood()
Happy.
@endif
{greeting("Ann")} is here.
@do shout("hey", score)
@do wave()
@set scene = next_scene()
@set area = region()
@set seat = partner()
@do mood()
Done.
@endnode

@node Other
Other.
@endnode
