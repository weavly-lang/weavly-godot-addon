@node start
Welcome to the smoke test.
@fade_in
@play_sound "chime.ogg"
>Guide: Let the test begin.
@set $score = 10
@increase $score 5
@decrease $score 2
@setflag $has_key
@clearflag $has_key

@if $score > 10
    @jump choices
@elif $score == 10
    @jump choices
@else
    @jump choices
@endif
@endnode

@node choices
$player_name: Which path?

@options
@option "Roll the dice" -> random_node
@option [ $has_key ] "Use key" -> end
@endoptions
@endnode

@node random_node
@random
@case 1: @jump match_node
@case 1: @jump match_node
@endrandom
@endnode

@node match_node
@match
    @when $has_key
        You have the key.
        @jump end
    @when not $has_key
        No key needed.
        @jump end
@endmatch
@endnode

@node end
@detour tally
@set $been_to_start = visited(start)
@set $score = max($score, bonus(10))
@set $last_scene = end
@set $region = night
@set $names_match = $region == night and $last_scene != start and $partner == bob
@log $reputation, visit_count(choices) + 1
@finish
@endnode

@node tally
@set $choice_visits = visit_count(choices)
@endnode

@node arrival
You arrive with {max($score, 0) + 1} points, written as \{score}.
@draw empty
@draw city, night
@endnode

@node bob_greets
@meta
pool: city
slot: bob
when: $score >= 0
priority: 2
weight: 1 + skip_count()
once: true
@endmeta
>Bob: Welcome back, {$player_name}. The market waited {skip_count(night_market)} times and charges {meta(night_market, toll)}.
@endnode

@node night_market
@meta
pool: city, night
slot: bob
priority: 1
toll: 2 + 1
@endmeta
The night market is open.
@endnode

@node plaza
@meta
pool: night
@endmeta
The plaza is quiet.
@endnode

@node modifiers
@match last
    @when true
        First match.
    @when $score >= 0
        Last match.
@endmatch
@match all
    @when true
        One of all.
    @when not $has_key
        Two of all.
@endmatch
@endnode
