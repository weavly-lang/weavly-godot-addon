@env
var gold: number = 0
var drinks: number = 0
var left: bool = false
func header(title: string, gold: number)
@endenv

@node tavern
>Innkeeper: Welcome, you have {$gold} gold.
@do header("Tavern", $gold + 1)
@increase $gold 5
@options
@option "Buy a drink"
    @increase $drinks
    The drink is cold.
    @jump bar
@option [ $gold > 100 ] "Rent a room": @jump room
@endoptions
The fire crackles.
@options
@option "Leave": @set $left = true
@endoptions
@continue "Look around"
@endnode

@node bar
>Barkeep: {$drinks} drinks so far.
@options
@option "Another": @jump bar
@endoptions
@endnode

@node room
Unreachable.
@endnode

@node lobby
@jump tavern
@endnode

@node lucky
@random
@case 1: Heads.
@case 1: Tails.
@endrandom
@set $gold = random(1, 1000000)
@endnode

@node stop
Before.
@finish
After.
@endnode

@node faulty
@options
@option "Divide": @set $gold = $gold / $drinks
@endoptions
@endnode
