@env
var gold: number = 0
character Innkeeper
character Barkeep
var drinks: number = 0
var left: bool = false
func header(title: string, gold: number)
func spend(amount: number)
@endenv

@node Tavern
Innkeeper: Welcome, you have {gold} gold.
@do header("Tavern", gold + 1)
@increase gold 5
@options
@option "Buy a drink"
    @increase drinks
    The drink is cold.
    @jump Bar
@option [ gold > 100 ] "Rent a room": @jump Room
@endoptions
The fire crackles.
@options
@option "Leave": @set left = true
@endoptions
@continue "Look around"
@endnode

@node Bar
Barkeep: {drinks} drinks so far.
@options
@option "Another": @jump Bar
@endoptions
@endnode

@node Room
Unreachable.
@endnode

@node Lobby
@jump Tavern
@endnode

@node Lucky
@random
@case 1: Heads.
@case 1: Tails.
@endrandom
@set gold = random(1, 1000000)
@endnode

@node Stop
Before.
@finish
After.
@endnode

@node Faulty
@options
@option "Divide": @set gold = gold / drinks
@endoptions
@endnode

@node Pay
@do spend(3)
@if gold < 0
In debt.
@endif
@endnode

@node Shop
@options
@option "Pay"
    @do spend(3)
    @if gold < 0
    In debt.
    @endif
@endoptions
@endnode
