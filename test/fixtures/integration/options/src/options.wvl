@node menu
@options
@option "Go on" -> after
@endoptions
@endnode

@node after
After
@finish
@endnode

@node none
@options
@option [ false ] "Open": @finish
@endoptions
Nothing to choose
@finish
@endnode

@env
func open(): flag
@endenv

@node door
@options
@option [ open() ] "Open"
    The door opens.
@option "Roll {random(1, 6)}" -> after
@option "Leave" -> after
@endoptions
@endnode

@node stay
@options
@option "Stay"
@endoptions
Stayed
@finish
@endnode
