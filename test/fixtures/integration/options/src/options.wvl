@node menu
@options
@option "Go on": @jump after
@endoptions
@endnode

@node after
After
@finish
@endnode

@node none
@options
@option [ false ] "Open": @finish
@endoptions
Nothing to choose
@finish
@endnode

@env
func open(): bool
@endenv

@node door
@options
@option [ open() ] "Open"
    The door opens.
@option "Roll {random(1, 6)}": @jump after
@option "Leave": @jump after
@endoptions
@endnode

@node stay
@options
@option "Stay"
@endoptions
Stayed
@finish
@endnode
