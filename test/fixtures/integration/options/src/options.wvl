@node Menu
@options
@option "Go on": @jump After
@endoptions
@endnode

@node After
After
@finish
@endnode

@node None
@options
@option [ false ] "Open": @finish
@endoptions
Nothing to choose
@finish
@endnode

@env
func open(): bool
@endenv

@node Door
@options
@option [ open() ] "Open"
    The door opens.
@option "Roll {random(1, 6)}": @jump After
@option "Leave": @jump After
@endoptions
@endnode

@node Stay
@options
@option "Stay"
@endoptions
Stayed
@finish
@endnode
