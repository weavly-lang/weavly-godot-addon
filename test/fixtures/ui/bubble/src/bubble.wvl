@node start
>guard: Halt! Who goes there?
The gate creaks.
>merchant: Fresh bread!
>stranger: Psst.
@options
@option "Answer" -> answered
@endoptions
@endnode

@node answered
>guard: Pass, then.
@endnode

@node bark
>guard: Move along.
>guard: I said move along.
@endnode

@node formatted
>guard: Hello [b]world[/b].
@options
@option "[i]Wave[/i]" -> answered
@endoptions
@endnode

@env
func open(): flag
@endenv

@node door
@options
@option [ open() ] "Open" -> answered
@option "Stay" -> answered
@endoptions
@endnode
