@env
character Guard
character Merchant
@endenv

@node Start
Guard: Halt! Who goes there?
The gate creaks.
Merchant: Fresh bread!
"Stranger": Psst.
@options
@option "Answer": @jump Answered
@endoptions
@endnode

@node Answered
Guard: Pass, then.
@endnode

@node Bark
Guard: Move along.
Guard: I said move along.
@endnode

@node Formatted
Guard: Hello [b]world[/b].
@options
@option "[i]Wave[/i]": @jump Answered
@endoptions
@endnode

@env
func open(): bool
@endenv

@node Door
@options
@option [ open() ] "Open": @jump Answered
@option "Stay": @jump Answered
@endoptions
@endnode
