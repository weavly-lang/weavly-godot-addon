@node start
>guard: Halt! Who goes there?
The gate creaks.
>merchant: Fresh bread!
>stranger: Psst.
@options
@option "Answer": @jump answered
@endoptions
@endnode

@node answered
>guard: Pass, then.
@endnode

@node bark
>guard: Move along.
>guard: I said move along.
@endnode

@node formatted
>guard: Hello [b]world[/b].
@options
@option "[i]Wave[/i]": @jump answered
@endoptions
@endnode

@env
func open(): bool
@endenv

@node door
@options
@option [ open() ] "Open": @jump answered
@option "Stay": @jump answered
@endoptions
@endnode
