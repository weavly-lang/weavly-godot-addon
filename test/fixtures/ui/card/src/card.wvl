@env
var gold: number = 0
character Guide
pool city
pool night
pool empty
pool styled
pool doors
func header(title: string)
func open(): bool
@endenv

@node Inn
@meta
pool: city
priority: 3
@endmeta
Guide: A stranger waves you over.
@options
@option "Join them": @jump InnEffect
@endoptions
@endnode

@node Market
@meta
pool: city
priority: 2
@endmeta
Someone grabs your purse.
@do header("Market")
@options
@option "Chase": @jump Chase
@option "Let go": @jump LetGo
@endoptions
@endnode

@node Bridge
@meta
pool: city
priority: 1
@endmeta
A troll blocks the way.
@endnode

@node Well
@meta
pool: city
@endmeta
The well is dry.
@endnode

@node Owl
@meta
pool: night
@endmeta
An owl watches you.
@options
@option "Watch back": @jump LetGo
@endoptions
@endnode

@node InnEffect
@increase gold 5
You win 5 gold at cards.
@endnode

@node Chase
You catch the thief.
@options
@option "Keep running": @jump KeepRunning
@endoptions
@endnode

@node KeepRunning
You're out of breath.
@endnode

@node LetGo
The thief escapes.
@endnode

@node Formatted
@meta
pool: styled
@endmeta
Guide: Hello [b]world[/b].
@options
@option "[i]Wave[/i]": @jump LetGo
@endoptions
@endnode

@env
pool teased
@endenv

@node TeasedStorylet
@meta
pool: teased
label: "A door"
label_teaser: "A closed door"
when: false
@endmeta
Behind the door.
@endnode

@node OpenStorylet
@meta
pool: teased
@endmeta
An open square.
@endnode

@node Door
@meta
pool: doors
@endmeta
@options
@option [ open() ] "Open": @jump LetGo
@option "Stay": @jump LetGo
@endoptions
@endnode
