@env
var gold: number = 0
pool city
pool night
pool empty
pool styled
pool doors
func header(title: string)
func open(): bool
@endenv

@node inn
@meta
pool: city
priority: 3
@endmeta
>guide: A stranger waves you over.
@options
@option "Join them": @jump inn_effect
@endoptions
@endnode

@node market
@meta
pool: city
priority: 2
@endmeta
Someone grabs your purse.
@do header("Market")
@options
@option "Chase": @jump chase
@option "Let go": @jump let_go
@endoptions
@endnode

@node bridge
@meta
pool: city
priority: 1
@endmeta
A troll blocks the way.
@endnode

@node well
@meta
pool: city
@endmeta
The well is dry.
@endnode

@node owl
@meta
pool: night
@endmeta
An owl watches you.
@options
@option "Watch back": @jump let_go
@endoptions
@endnode

@node inn_effect
@increase $gold 5
You win 5 gold at cards.
@endnode

@node chase
You catch the thief.
@options
@option "Keep running": @jump keep_running
@endoptions
@endnode

@node keep_running
You're out of breath.
@endnode

@node let_go
The thief escapes.
@endnode

@node formatted
@meta
pool: styled
@endmeta
>guide: Hello [b]world[/b].
@options
@option "[i]Wave[/i]": @jump let_go
@endoptions
@endnode

@env
pool teased
@endenv

@node teased_storylet
@meta
pool: teased
label: "A door"
label_teaser: "A closed door"
when: false
@endmeta
Behind the door.
@endnode

@node open_storylet
@meta
pool: teased
@endmeta
An open square.
@endnode

@node door
@meta
pool: doors
@endmeta
@options
@option [ open() ] "Open": @jump let_go
@option "Stay": @jump let_go
@endoptions
@endnode
