@node start
>mara: are you still up?
>me: yeah why
It's 21:04.
>stranger: hello?
@options
@option "what happened?" -> happened
@option "going to sleep" -> sleep
@endoptions
@endnode

@node happened
>mara: you won't believe it
@endnode

@node sleep
>mara: ok good night
@endnode

@node long
>mara: this message is long on purpose so that its bubble reaches the maximum width and wraps onto several lines
@endnode

@node burst
>mara: one
>mara: two
It's late.
>mara: three
@endnode

@node formatted
>mara: Hello [b]world[/b].
@options
@option "[i]Wave[/i]" -> sleep
@endoptions
@endnode

@node locked
@options
@option node(closed)
@endoptions
>mara: moving on
@endnode

@node closed
@meta
label: "open the door"
label_unavailable: "the door is locked"
available: false
@endmeta
@endnode

@env
func open(): flag
@endenv

@node door
@options
@option [ open() ] "Open" -> sleep
@option "Stay" -> sleep
@endoptions
@endnode
