@env
character Mara
character Me
@endenv

@node Start
Mara: are you still up?
Me: yeah why
It's 21:04.
"Stranger": hello?
@options
@option "what happened?": @jump Happened
@option "going to sleep": @jump Sleep
@endoptions
@endnode

@node Happened
Mara: you won't believe it
@endnode

@node Sleep
Mara: ok good night
@endnode

@node Long
Mara: this message is long on purpose so that its bubble reaches the maximum width and wraps onto several lines
@endnode

@node Burst
Mara: one
Mara: two
It's late.
Mara: three
@endnode

@node Formatted
Mara: Hello [b]world[/b].
@options
@option "[i]Wave[/i]": @jump Sleep
@endoptions
@endnode

@node Locked
@options
@option node(Closed)
@endoptions
Mara: moving on
@endnode

@node Closed
@meta
label: "open the door"
label_unavailable: "the door is locked"
available: false
@endmeta
@endnode

@env
func open(): bool
@endenv

@node Door
@options
@option [ open() ] "Open": @jump Sleep
@option "Stay": @jump Sleep
@endoptions
@endnode
