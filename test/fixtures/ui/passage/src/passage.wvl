@env
var gold: number = 0
func header(title: string)
func open(): bool
@endenv

@node tavern
>guide: Welcome, you have {$gold} gold.
@do header("Tavern")
@options
@option "Buy a drink"
    @increase $gold 1
    The drink is cold.
    @jump bar
@option "Leave": @jump street
@endoptions
>Stranger: Mind the fire.
@options
@option "Warm up": @jump fire
@endoptions
@endnode

@node bar
The barkeep nods.
@options
@option "Back": @jump tavern
@endoptions
@endnode

@node street
The street is empty.
@endnode

@node fire
You warm up.
@endnode

@node formatted
Hello [b]world[/b].
@options
@option "[i]Wave[/i]": @jump tavern
@endoptions
@endnode

@node door
@options
@option [ open() ] "Open": @jump street
@option "Stay": @jump street
@endoptions
@endnode
