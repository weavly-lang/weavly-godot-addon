@env
var gold: number = 0
character Guide
func header(title: string)
func open(): bool
@endenv

@node Tavern
Guide: Welcome, you have {gold} gold.
@do header("Tavern")
@options
@option "Buy a drink"
    @increase gold 1
    The drink is cold.
    @jump Bar
@option "Leave": @jump Street
@endoptions
"Stranger": Mind the fire.
@options
@option "Warm up": @jump Fire
@endoptions
@endnode

@node Bar
The barkeep nods.
@options
@option "Back": @jump Tavern
@endoptions
@endnode

@node Street
The street is empty.
@endnode

@node Fire
You warm up.
@endnode

@node Formatted
Hello [b]world[/b].
@options
@option "[i]Wave[/i]": @jump Tavern
@endoptions
@endnode

@node Door
@options
@option [ open() ] "Open": @jump Street
@option "Stay": @jump Street
@endoptions
@endnode
