@env
var gold: number = 0
command header(title: string)
@endenv

@node tavern
>guide: Welcome, you have {$gold} gold.
@header "Tavern"
@options
@option "Buy a drink"
    @increase $gold 1
    The drink is cold.
    @jump bar
@option "Leave" -> street
@endoptions
>Stranger: Mind the fire.
@options
@option "Warm up" -> fire
@endoptions
@endnode

@node bar
The barkeep nods.
@options
@option "Back" -> tavern
@endoptions
@endnode

@node street
The street is empty.
@endnode

@node fire
You warm up.
@endnode

@node formatted
Hello [b]world[/b].
@options
@option "[i]Wave[/i]" -> tavern
@endoptions
@endnode
