@node start
>guide: Hello there.
The wind picks up.
>innkeeper: Welcome.
>stranger: Who are you?
@options
@option "Wave": @jump waved
@endoptions
@endnode

@node waved
You wave.
@endnode

@node formatted
Hello [b]world[/b].
@options
@option "[i]Wave[/i]": @jump waved
@endoptions
@endnode

@node crossroads
@options
@option "Left": @jump left
@option "Right": @jump right
@endoptions
@endnode

@node left
You go left.
@endnode

@node right
You go right.
@endnode

@env
var has_code: bool = false
@endenv

@node gated
@options
@option node(vault)
@option "Leave"
    Bye.
@endoptions
@endnode

@node sealed
@options
@option node(vault)
@endoptions
You walk on.
@endnode

@node vault
@meta
label: "Open the vault"
label_unavailable: "The vault is sealed"
available: $has_code
@endmeta
Opened.
@endnode

@env
func open(): bool
@endenv

@node door
@options
@option [ open() ] "Open": @jump waved
@option "Stay": @jump waved
@endoptions
@endnode
