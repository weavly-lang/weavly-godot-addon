@node start
>guide: Hello there.
The wind picks up.
>innkeeper: Welcome.
>stranger: Who are you?
@options
@option "Wave" -> waved
@endoptions
@endnode

@node waved
You wave.
@endnode

@node formatted
Hello [b]world[/b].
@options
@option "[i]Wave[/i]" -> waved
@endoptions
@endnode

@node crossroads
@options
@option "Left" -> left
@option "Right" -> right
@endoptions
@endnode

@node left
You go left.
@endnode

@node right
You go right.
@endnode

@env
var has_code: flag = false
@endenv

@node gated
@options
@option node(vault)
@option "Leave"
    Bye.
@endoptions
@endnode

@node sealed
@options
@option node(vault)
@endoptions
You walk on.
@endnode

@node vault
@meta
label: "Open the vault"
label_unavailable: "The vault is sealed"
available: $has_code
@endmeta
Opened.
@endnode

@env
func open(): flag
@endenv

@node door
@options
@option [ open() ] "Open" -> waved
@option "Stay" -> waved
@endoptions
@endnode
