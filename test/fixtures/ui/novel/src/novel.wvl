@env
character Guide
character Innkeeper
@endenv

@node Start
Guide: Hello there.
The wind picks up.
Innkeeper: Welcome.
"Stranger": Who are you?
@options
@option "Wave": @jump Waved
@endoptions
@endnode

@node Waved
You wave.
@endnode

@node Formatted
Hello [b]world[/b].
@options
@option "[i]Wave[/i]": @jump Waved
@endoptions
@endnode

@node Crossroads
@options
@option "Left": @jump Left
@option "Right": @jump Right
@endoptions
@endnode

@node Left
You go left.
@endnode

@node Right
You go right.
@endnode

@env
var has_code: bool = false
@endenv

@node Gated
@options
@option node(Vault)
@option "Leave"
    Bye.
@endoptions
@endnode

@node Sealed
@options
@option node(Vault)
@endoptions
You walk on.
@endnode

@node Vault
@meta
label: "Open the vault"
label_unavailable: "The vault is sealed"
available: has_code
@endmeta
Opened.
@endnode

@env
func open(): bool
@endenv

@node Door
@options
@option [ open() ] "Open": @jump Waved
@option "Stay": @jump Waved
@endoptions
@endnode
