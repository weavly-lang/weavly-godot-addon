@node start
>guide: Hello there.
The wind picks up.
>innkeeper: Welcome.
>stranger: Who are you?
@options
@option "Wave" -> waved
@hint "Fight (too tired)"
@endoptions
@endnode

@node waved
You wave.
@endnode

@node hints
@options
@hint "Locked door"
@endoptions
You walk on.
@endnode

@node formatted
Hello [b]world[/b].
@endnode

@node crossroads
@options
@option "Left" -> left
@option "Right" -> right
@endoptions
@endnode

@node left
You go left.
@endnode

@node right
You go right.
@endnode
