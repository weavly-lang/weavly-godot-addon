@env
var gold: number = 3
var name: string = "Robin"
var brave: bool = false
extern var secret: number
var target: node = Gate
var area: pool = city
var partner: slot = pair
pool city
slot pair
@endenv

@node Start
Hello {name}.
@increase gold 2
Second line.
@jump Gate
@endnode

@node Gate
The gate is shut.
@endnode

@node Broken
The secret is {secret}.
@endnode

@node Bob
@meta
pool: city
when: gold > 2
priority: 1
@endmeta
Bob waves.
@endnode

@node Ann
@meta
pool: city
@endmeta
Ann nods.
@endnode

@node AsideStart
@meta
priority: secret
@endmeta
@detour Gate
@endnode
