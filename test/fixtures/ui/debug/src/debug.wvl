@env
var gold: number = 3
var name: string = "Robin"
var brave: flag = false
extern var secret: number
pool city
@endenv

@node start
Hello {$name}.
@increase $gold 2
Second line.
@jump gate
@endnode

@node gate
The gate is shut.
@endnode

@node broken
The secret is {$secret}.
@endnode

@node bob
@meta
pool: city
when: $gold > 2
priority: 1
@endmeta
Bob waves.
@endnode

@node ann
@meta
pool: city
@endmeta
Ann nods.
@endnode
