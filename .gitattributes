# Normalize text to LF in the repository. CI rebuilds test/fixtures/integration/ci_smoke/
# and compares the result byte for byte, which CRLF would break.
* text=auto eol=lf

*.png binary
*.ogv binary
*.webp binary
*.svg text eol=lf

# The Asset Library installs the repository archive into the user's project, so
# everything that is not the addon itself is kept out of it. This affects
# `git archive` only: clones, and raw file URLs, are untouched.
/.editorconfig export-ignore
/.gitattributes export-ignore
/.github export-ignore
/.gitignore export-ignore
/CLAUDE.md export-ignore
/CONTRIBUTING.md export-ignore
/LICENSE export-ignore
/README.md export-ignore
/branding export-ignore
/ci export-ignore
/gdformatrc export-ignore
/gdlintrc export-ignore
/icon.svg export-ignore
/icon.svg.import export-ignore
/project.godot export-ignore
/test export-ignore
/addons/gdUnit4 export-ignore
